{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "build",
    "runtime",
    "components",
    "images",
    "contract",
    "database"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "tagObjectSha", "sourceCommit"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tagObjectSha": {
          "type": "string",
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "createdAt"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "workflow": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "runnerImage", "os", "arch", "libc", "libcVersion"],
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "pnpm": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "runnerImage": {
          "type": "string",
          "enum": ["ubuntu-24.04"]
        },
        "os": {
          "type": "string",
          "enum": ["linux"]
        },
        "arch": {
          "type": "string",
          "enum": ["x64"]
        },
        "libc": {
          "type": "string",
          "enum": ["glibc"]
        },
        "libcVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "server"],
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "sha256"],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^qsmds-web-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.tar\\.gz$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "sha256", "platform", "arch"],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^qsmds-server-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-linux-x64\\.tar\\.gz$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "platform": {
              "type": "string",
              "enum": ["linux"]
            },
            "arch": {
              "type": "string",
              "enum": ["x64"]
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "web"],
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest", "archive", "platform", "arch", "sha256", "size"],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^qsmds-server:v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "archive": {
              "type": "string",
              "pattern": "^qsmds-server-image-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-linux-x64\\.tar\\.gz$"
            },
            "platform": {
              "type": "string",
              "enum": ["linux"]
            },
            "arch": {
              "type": "string",
              "enum": ["x64"]
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest", "archive", "platform", "arch", "sha256", "size"],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^qsmds-web:v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "archive": {
              "type": "string",
              "pattern": "^qsmds-web-image-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-linux-x64\\.tar\\.gz$"
            },
            "platform": {
              "type": "string",
              "enum": ["linux"]
            },
            "arch": {
              "type": "string",
              "enum": ["x64"]
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "openapiSha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "openapiSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationHead", "schemaSha256", "migrationsSha256"],
      "properties": {
        "migrationHead": {
          "type": "string",
          "pattern": "^[0-9]{14}_[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "schemaSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "migrationsSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
