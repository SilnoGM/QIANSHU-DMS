NODE_ENV=development
PORT=3000
DATABASE_URL=
# 仅 prisma:drift:check 使用；必须指向名称以 qianshu_dms_shadow_ 开头的独立临时数据库。
SHADOW_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:9000
TRUST_PROXY_HOPS=0
AUTH_ARGON2_CONCURRENCY=2
AUTH_ARGON2_QUEUE_LIMIT=32
# production 必须分别提供三个独立、32-byte 的 canonical base64url key；development/test 留空时启动进程会随机生成。
AUTH_USERNAME_HMAC_KEY=
AUTH_USER_ID_HMAC_KEY=
AUTH_IP_HMAC_KEY=
# 开发默认 local；根目录必须由部署侧预创建在源码、release 与系统临时目录之外。
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=/var/lib/qianshu-dms/media
# development/test 默认 application；production 默认 internal_redirect，无 Nginx 的单机部署可显式使用 application。
# 注意：cos 驱动下只能使用 application。
MEDIA_CONTENT_DELIVERY_MODE=application
MEDIA_STAGING_TTL_HOURS=24
MEDIA_TRASH_RETENTION_DAYS=7
# 必须使用部署环境中的绝对可执行路径；缺失时对应 VIDEO/PDF 验证与视频封面能力失败关闭。
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_QPDF_PATH=/usr/bin/qpdf
# 仅在本地受控验收 COS 驱动时填写：开发环境默认保持 local，凭据不会进入版本库，
# 一次性覆盖示例：MEDIA_STORAGE_DRIVER=cos node dist/commands/media-operations.js health
MEDIA_COS_REGION=ap-beijing
MEDIA_COS_BUCKET=
MEDIA_COS_SECRET_ID=
MEDIA_COS_SECRET_KEY=
