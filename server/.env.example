NODE_ENV=development
PORT=3000
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:9000
TRUST_PROXY_HOPS=0
AUTH_ARGON2_CONCURRENCY=2
AUTH_ARGON2_QUEUE_LIMIT=32
# production 必须分别提供三个独立、32-byte 的 canonical base64url key；development/test 留空时启动进程会随机生成。
AUTH_USERNAME_HMAC_KEY=
AUTH_USER_ID_HMAC_KEY=
AUTH_IP_HMAC_KEY=
# 首期仅支持 local；根目录必须由部署侧预创建在源码、release 与系统临时目录之外。
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=/var/lib/qianshu-dms/media
MEDIA_STAGING_TTL_HOURS=24
MEDIA_TRASH_RETENTION_DAYS=7
# 必须使用部署环境中的绝对可执行路径；缺失时对应 VIDEO/PDF 验证能力失败关闭。
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_QPDF_PATH=/usr/bin/qpdf
