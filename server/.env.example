NODE_ENV=development
PORT=3000
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:9000
TRUST_PROXY_HOPS=0
AUTH_ARGON2_CONCURRENCY=2
AUTH_ARGON2_QUEUE_LIMIT=32
# production 必须分别提供三个独立、32-byte 的 canonical base64url key；development/test 留空时启动进程会随机生成。
AUTH_USERNAME_HMAC_KEY=
AUTH_USER_ID_HMAC_KEY=
AUTH_IP_HMAC_KEY=
