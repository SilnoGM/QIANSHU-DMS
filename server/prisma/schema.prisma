model User {
  containerLoadingItemChanges ContainerLoadingItemChange[]
  containerBatchesCreated ContainerBatch[] @relation("ContainerBatchCreatedBy")
  containerBatchesUpdated ContainerBatch[] @relation("ContainerBatchUpdatedBy")
  slhBillsCreated SlhBill[] @relation("SlhBillCreatedBy")
  slhBillsUpdated SlhBill[] @relation("SlhBillUpdatedBy")
  reconciliationBatchesCreated SlhReconciliationBatch[] @relation("SlhReconciliationBatchCreatedBy")
  reconciliationBatchesUpdated SlhReconciliationBatch[] @relation("SlhReconciliationBatchUpdatedBy")
  reconciliationBatchesCompleted SlhReconciliationBatch[] @relation("SlhReconciliationBatchCompletedBy")
  reconciliationBatchLinesReconciled SlhReconciliationBatchLine[] @relation("SlhReconciliationBatchLineReconciledBy")
  reconciliationSettlementsCreated SlhReconciliationSettlement[] @relation("SlhReconciliationSettlementCreatedBy")
  invoiceRequestsCreated InvoiceRequest[] @relation("InvoiceRequestCreatedBy")
  invoiceRequestsNotified InvoiceRequest[] @relation("InvoiceRequestNotifiedBy")
  invoiceRequestsReturned InvoiceRequest[] @relation("InvoiceRequestReturnedBy")
  invoiceRequestsDocumentUploaded InvoiceRequest[] @relation("InvoiceRequestDocumentUploadedBy")
  invoiceRequestsSettled InvoiceRequest[] @relation("InvoiceRequestSettledBy")
  invoiceRequestsCancelled InvoiceRequest[] @relation("InvoiceRequestCancelledBy")
  invoiceRequestStatusHistoryRecorded InvoiceRequestStatusHistory[] @relation("InvoiceRequestStatusHistoryActor")
  containerLoadingItemsCreated ContainerLoadingItem[] @relation("ContainerLoadingItemCreatedBy")
  containerLoadingItemsUpdated ContainerLoadingItem[] @relation("ContainerLoadingItemUpdatedBy")

  paymentRecipientProfilesCreated PaymentRecipientProfile[] @relation("PaymentRecipientProfileCreator")
  paymentRecipientProfilesUpdated PaymentRecipientProfile[] @relation("PaymentRecipientProfileUpdater")
  purchasePayablesOwned PurchaseOrderPayable[] @relation("PurchasePayableOwner")
  purchasePayablesCreated PurchaseOrderPayable[] @relation("PurchasePayableCreatedBy")
  packagingCostsOwned PackagingCostRequest[] @relation("PackagingCostOwner")
  packagingCostsSubmitted PackagingCostRequest[] @relation("PackagingCostSubmitter")
  packagingCostsPaid PackagingCostRequest[] @relation("PackagingCostPayer")
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String     @db.VarChar(128)
  usernameNormalized String     @unique(map: "users_username_normalized_key") @map("username_normalized") @db.VarChar(128)
  displayName        String     @map("display_name") @db.VarChar(128)
  passwordHash       String     @map("password_hash") @db.Text
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime   @map("password_changed_at") @db.Timestamptz(6)
  authVersion        Int        @default(0) @map("auth_version")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdByUserId    String?    @map("created_by_user_id") @db.Uuid
  disabledAt         DateTime?  @map("disabled_at") @db.Timestamptz(6)
  disabledByUserId   String?    @map("disabled_by_user_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy                   User?                      @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers                User[]                     @relation("UserCreatedBy")
  disabledBy                  User?                      @relation("UserDisabledBy", fields: [disabledByUserId], references: [id], onDelete: Restrict)
  disabledUsers               User[]                     @relation("UserDisabledBy")
  roles                       UserRole[]
  sessions                    AuthSession[]
  auditEvents                 AuditEvent[]               @relation("AuditActor")
  profile                     UserProfile?
  productsCreated             Product[]                  @relation("ProductCreatedBy")
  productsUpdated             Product[]                  @relation("ProductUpdatedBy")
  mediaAssetsCreated          MediaAsset[]               @relation("MediaAssetCreatedBy")
  productMediaCreated         ProductMedia[]             @relation("ProductMediaCreatedBy")
  productMediaDetached        ProductMedia[]             @relation("ProductMediaDetachedBy")
  fundAccount                 FundAccount?               @relation("FundAccountUser")
  fundRuleVersionsCreated     FundPostingRuleVersion[]   @relation("FundRuleVersionCreatedBy")
  fundRuleVersionsPublished   FundPostingRuleVersion[]   @relation("FundRuleVersionPublishedBy")
  fundPostingBatches          FundPostingBatch[]         @relation("FundPostingBatchUser")
  fundPostingBatchesActed     FundPostingBatch[]         @relation("FundPostingBatchActor")
  fundWithdrawalRequests      FundWithdrawalRequest[]    @relation("FundWithdrawalRequestUser")
  fundWithdrawalRequestsReviewed FundWithdrawalRequest[] @relation("FundWithdrawalRequestReviewedBy")
  receiptRequestsOwned SalesReceiptRequest[] @relation("ReceiptAccountOwner")
  receiptRequestsSubmitted SalesReceiptRequest[] @relation("ReceiptSubmittedBy")
  receiptRequestsReviewed SalesReceiptRequest[] @relation("ReceiptReviewedBy")
  salesOrdersIssued           SalesOrder[]               @relation("SalesOrderIssuer")
  salesOrderPaymentsCreated   SalesOrderPayment[]        @relation("SalesOrderPaymentCreatedBy")
  salesOrderPaymentsVoided    SalesOrderPayment[]        @relation("SalesOrderPaymentVoidedBy")
  salesOrderDocumentsCreated  SalesOrderDocument[]       @relation("SalesOrderDocumentCreatedBy")
  salesOrderDocumentsDetached SalesOrderDocument[]       @relation("SalesOrderDocumentDetachedBy")
  salesOrderStatusesChanged   SalesOrderStatusHistory[]  @relation("SalesOrderStatusChangedBy")
  salesOrderAmountsChanged    SalesOrderAmountRevision[] @relation("SalesOrderAmountChangedBy")
  purchaseOrdersCreated             PurchaseOrder[]              @relation("PurchaseOrderCreatedBy")
  purchaseOrderPartsShipped         PurchaseOrderPart[] @relation("PurchaseOrderPartShippedBy")
  purchaseOrderPartsWarehouseReceived PurchaseOrderPart[] @relation("PurchaseOrderPartWarehouseReceivedBy")
  purchaseOrderPartsLoaded          PurchaseOrderPart[] @relation("PurchaseOrderPartLoadedBy")
  purchaseOrderPartsDelivered       PurchaseOrderPart[] @relation("PurchaseOrderPartDeliveredBy")
  purchaseOrderPaymentsCreated      PurchaseOrderPayment[]       @relation("PurchaseOrderPaymentCreatedBy")
  purchaseOrderPaymentsVoided       PurchaseOrderPayment[]       @relation("PurchaseOrderPaymentVoidedBy")
  purchaseOrderDocumentsCreated     PurchaseOrderDocument[]      @relation("PurchaseOrderDocumentCreatedBy")
  purchaseOrderImageDraftsGenerated PurchaseOrderImageDraft[]
  purchaseOrderDocumentsDetached    PurchaseOrderDocument[]      @relation("PurchaseOrderDocumentDetachedBy")
  purchaseOrderStatusesChanged      PurchaseOrderStatusHistory[] @relation("PurchaseOrderStatusChangedBy")
  purchaseOrderAmountsChanged       PurchaseOrderAmountRevision[] @relation("PurchaseOrderAmountChangedBy")
  shippingMarkBindingsCreated       SupplierShippingMarkRuleBinding[] @relation("ShippingMarkBindingCreatedBy")
  shippingMarkBindingsUpdated       SupplierShippingMarkRuleBinding[] @relation("ShippingMarkBindingUpdatedBy")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Uuid
  email           String?  @db.VarChar(254)
  emailNormalized String?  @unique(map: "user_profiles_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  mobileE164      String?  @unique(map: "user_profiles_mobile_e164_key") @map("mobile_e164") @db.VarChar(16)
  avatarUrl       String?  @map("avatar_url") @db.VarChar(2048)
  avatarMediaAssetId String? @unique(map: "user_profiles_avatar_media_asset_id_key") @map("avatar_media_asset_id") @db.Uuid
  remark          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMediaAsset MediaAsset? @relation("UserProfileAvatar", fields: [avatarMediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("user_profiles")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "roles_code_key") @db.VarChar(128)
  name        String  @db.VarChar(128)
  description String? @db.Text
  isSystem    Boolean @default(false) @map("is_system")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "permissions_code_key") @db.VarChar(128)
  name        String  @db.VarChar(128)
  description String? @db.Text
  systemOnly  Boolean @default(false) @map("system_only")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId, userId], map: "user_roles_role_id_user_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId, roleId], map: "role_permissions_permission_id_role_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenHash         Bytes                 @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.ByteA
  authVersion       Int                   @map("auth_version")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime              @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     SessionRevokedReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, absoluteExpiresAt], map: "auth_sessions_user_id_revoked_at_absolute_expires_at_idx")
  @@index([idleExpiresAt], map: "auth_sessions_idle_expires_at_idx")
  @@map("auth_sessions")
}

model AuthRateLimit {
  scope           AuthRateLimitScope
  subjectKeyHash  Bytes              @map("subject_key_hash") @db.ByteA
  bucketStartedAt DateTime           @map("bucket_started_at") @db.Timestamptz(6)
  attemptCount    Int                @default(0) @map("attempt_count")
  blockedUntil    DateTime?          @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, subjectKeyHash], map: "auth_rate_limits_scope_subject_key_hash_key")
  @@index([updatedAt], map: "auth_rate_limits_updated_at_idx")
  @@index([blockedUntil], map: "auth_rate_limits_blocked_until_idx")
  @@map("auth_rate_limits")
}

model AuditEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     AuditEventType @map("event_type")
  outcome       AuditOutcome
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  targetType    String?        @map("target_type") @db.VarChar(128)
  targetId      String?        @map("target_id") @db.VarChar(128)
  requestId     String         @map("request_id") @db.VarChar(64)
  correlationId String?        @map("correlation_id") @db.VarChar(128)
  reasonCode    String?        @map("reason_code") @db.VarChar(128)
  sourceIpHash  Bytes?         @map("source_ip_hash") @db.ByteA
  metadata      Json           @default("{}") @db.JsonB

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_occurred_at_id_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_events_actor_user_id_occurred_at_idx")
  @@index([eventType, occurredAt(sort: Desc)], map: "audit_events_event_type_occurred_at_idx")
  @@map("audit_events")
}

model Region {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String      @unique(map: "regions_code_key") @db.VarChar(64)
  name               String      @db.VarChar(128)
  normalizedName     String      @map("normalized_name") @db.VarChar(128)
  englishName        String?     @map("english_name") @db.VarChar(128)
  sourceName         String?     @map("source_name") @db.VarChar(128)
  sourceCode         String?     @map("source_code") @db.VarChar(64)
  administrativeType String      @map("administrative_type") @db.VarChar(64)
  level              RegionLevel
  parentId           String?     @map("parent_id") @db.Uuid
  enabled            Boolean     @default(true)
  sortOrder          Int         @default(0) @map("sort_order")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                     Region?      @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children                   Region[]     @relation("RegionHierarchy")
  salesOrdersAsCountryRegion SalesOrder[] @relation("SalesOrderCountryRegion")
  salesOrdersAsProvinceState SalesOrder[] @relation("SalesOrderProvinceState")
  salesOrdersAsCity          SalesOrder[] @relation("SalesOrderCity")

  @@unique([parentId, normalizedName], map: "regions_parent_id_normalized_name_key")
  @@index([parentId, sortOrder, normalizedName, id], map: "regions_parent_id_sort_order_name_id_idx")
  @@index([level, enabled, normalizedName, id], map: "regions_level_enabled_name_id_idx")
  @@map("regions")
}

model Currency {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "currencies_code_key") @db.VarChar(3)
  name        String   @db.VarChar(128)
  englishName String?  @map("english_name") @db.VarChar(128)
  symbol      String?  @db.VarChar(16)
  minorUnit   Int      @default(2) @map("minor_unit") @db.SmallInt
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exchangeRate ExchangeRate?
  salesOrders  SalesOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([enabled, sortOrder, code, id], map: "currencies_enabled_sort_order_code_id_idx")
  @@map("currencies")
}

model ExchangeRate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyId         String   @unique(map: "exchange_rates_currency_id_key") @map("currency_id") @db.Uuid
  foreignUnitsPerCny Decimal  @map("foreign_units_per_cny") @db.Decimal(30, 4)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  salesOrderPayments SalesOrderPayment[]
  slhBills SlhBill[]
  invoiceRequests InvoiceRequest[]
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "exchange_rates_updated_at_id_idx")
  @@map("exchange_rates")
}

model DictionaryType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "dictionary_types_code_key") @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(500)
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items DictionaryItem[]

  @@index([sortOrder, code, id], map: "dictionary_types_sort_order_code_id_idx")
  @@index([enabled, sortOrder, code, id], map: "dictionary_types_enabled_sort_order_code_id_idx")
  @@map("dictionary_types")
}

model DictionaryItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dictionaryTypeId String         @map("dictionary_type_id") @db.Uuid
  value            String         @db.VarChar(64)
  label            String         @db.VarChar(128)
  description      String?        @db.VarChar(500)
  tone             DictionaryTone @default(DEFAULT)
  enabled          Boolean        @default(false)
  sortOrder        Int            @default(0) @map("sort_order")
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dictionaryType DictionaryType @relation(fields: [dictionaryTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dictionaryTypeId, value], map: "dictionary_items_dictionary_type_id_value_key")
  @@index([dictionaryTypeId, sortOrder, value, id], map: "dictionary_items_type_id_sort_order_value_id_idx")
  @@index([dictionaryTypeId, enabled, sortOrder, value, id], map: "dictionary_items_type_id_enabled_sort_order_value_id_idx")
  @@map("dictionary_items")
}

model ProductCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierValue String   @map("supplier_value") @db.VarChar(64)
  name          String   @db.VarChar(64)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  productHeads ProductHead[]
  products     Product[]

  @@unique([supplierValue, name], map: "product_categories_supplier_value_name_key")
  @@index([supplierValue, name], map: "product_categories_supplier_value_name_idx")
  @@index([supplierValue, sortOrder, name], map: "product_categories_supplier_sort_idx")
  @@map("product_categories")
}

model ProductHead {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String   @db.VarChar(64)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products Product[]

  @@unique([categoryId, name], map: "product_heads_category_id_name_key")
  @@index([categoryId, name], map: "product_heads_category_id_name_idx")
  @@index([categoryId, sortOrder, name], map: "product_heads_category_sort_idx")
  @@map("product_heads")
}

model Product {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String        @db.VarChar(128)
  categoryId           String?       @map("category_id") @db.Uuid
  productHeadId        String?       @map("product_head_id") @db.Uuid
  productNo            String        @unique(map: "products_product_no_key") @map("product_no") @db.VarChar(64)
  status               ProductStatus @default(ACTIVE)
  supplierValue        String        @map("supplier_value") @db.VarChar(64)
  sortOrder            Int           @default(0) @map("sort_order")
  twdSalePriceAmount   Decimal?      @map("twd_sale_price_amount") @db.Decimal(30, 2)
  twdSalePriceCurrency String        @default("TWD") @map("twd_sale_price_currency") @db.Char(3)
  myrSalePriceAmount   Decimal?      @map("myr_sale_price_amount") @db.Decimal(30, 2)
  myrSalePriceCurrency String        @default("MYR") @map("myr_sale_price_currency") @db.Char(3)
  purchaseCostAmount   Decimal?      @map("purchase_cost_amount") @db.Decimal(30, 2)
  purchaseCostCurrency String        @default("CNY") @map("purchase_cost_currency") @db.Char(3)
  attributes           Json          @default("[]") @db.JsonB
  remark               String?       @db.VarChar(512)
  createdByUserId      String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?       @map("updated_by_user_id") @db.Uuid
  version              Int           @default(1)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productHead     ProductHead?     @relation(fields: [productHeadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User?            @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy       User?            @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media           ProductMedia[]
  salesOrderLines SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)], map: "products_status_updated_at_id_idx")
  @@index([supplierValue, updatedAt(sort: Desc), id(sort: Desc)], map: "products_supplier_value_updated_at_id_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "products_updated_at_id_idx")
  @@index([categoryId, name], map: "products_category_id_name_idx")
  @@index([productHeadId, name], map: "products_product_head_id_name_idx")
  @@index([productHeadId, sortOrder, name], map: "products_product_head_sort_idx")
  @@map("products")
}

enum PackagingCostStatus {
  PENDING_PAYMENT
  PAID

  @@map("packaging_cost_status")
}

enum PackagingCostVendor {
  CHENGXIN
  OTHER

  @@map("packaging_cost_vendor")
}

model MediaAsset {
  containerBatchSources ContainerBatch[]

  // 付款截图准备时绑定具体定金/尾款阶段，不能被另一阶段消费。
  packagingCostUploadId String? @map("packaging_cost_upload_id") @db.Uuid
  packagingCostUpload PackagingCostRequest? @relation("PackagingCostVoucherUpload", fields: [packagingCostUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchasePayableUploadId String? @map("purchase_payable_upload_id") @db.Uuid
  purchasePayableUpload PurchaseOrderPayable? @relation("PurchasePayableVoucherUpload", fields: [purchasePayableUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "media_assets_purchase_payable_upload_fkey")
  // 仅专用收款码/付款截图上传标记用途，消费方不能互相复用临时文件。
  uploadPurpose String? @map("upload_purpose") @db.VarChar(64)
  paymentRecipientAccounts PaymentRecipientAccount[]
  paymentRecipientSnapshots PurchaseOrderPayment[] @relation("PurchasePaymentRecipientQr")
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaType        MediaType        @map("media_type")
  status           MediaAssetStatus @default(UPLOADING)
  storageDriver    String           @default("local") @map("storage_driver") @db.VarChar(32)
  objectKey        String?          @unique(map: "media_assets_object_key_key") @map("object_key") @db.VarChar(512)
  originalFilename String           @map("original_filename") @db.VarChar(255)
  mimeType         String?          @map("mime_type") @db.VarChar(127)
  sizeBytes        BigInt?          @map("size_bytes")
  checksumSha256   String?          @map("checksum_sha256") @db.Char(64)
  width            Int?
  height           Int?
  durationMs       Int?             @map("duration_ms")
  videoCodec       String?          @map("video_codec") @db.VarChar(32)
  audioCodec       String?          @map("audio_codec") @db.VarChar(32)
  uploadExpiresAt  DateTime?        @map("upload_expires_at") @db.Timestamptz(6)
  retentionUntil   DateTime?        @map("retention_until") @db.Timestamptz(6)
  failureCode      String?          @map("failure_code") @db.VarChar(64)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  createdBy           User                 @relation("MediaAssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyMigrations       MediaObjectKeyMigration[]
  packagingCostImages PackagingCostRequest[] @relation("PackagingCostImage")
  packagingPaymentImages PackagingCostRequest[] @relation("PackagingPaymentImage")
  packagingRecipientSnapshots PackagingCostRequest[] @relation("PackagingPaymentRecipientQr")
  packagingQuotationImages PackagingCostRequest[] @relation("PackagingQuotationImage")
  receiptRequests SalesReceiptRequest[]
  productMedia        ProductMedia[]
  salesOrderDocuments SalesOrderDocument[]
  purchaseOrderDocuments PurchaseOrderDocument[]
  purchaseOrderImageDraft PurchaseOrderImageDraft?
  slhBillSourceFiles  SlhBill[]
  invoiceRequestDocuments InvoiceRequest[]
  fundWithdrawalProofs FundWithdrawalRequest[] @relation("FundWithdrawalPaymentProof")
  avatarProfile UserProfile? @relation("UserProfileAvatar")

  @@index([status, uploadExpiresAt, id], map: "media_assets_status_upload_expires_at_id_idx")
  @@index([status, retentionUntil, id], map: "media_assets_status_retention_until_id_idx")
  @@index([packagingCostUploadId], map: "media_assets_packaging_cost_upload_idx")
  @@index([purchasePayableUploadId], map: "media_assets_purchase_payable_upload_idx")
  @@map("media_assets")
}

/// 存量对象键重命名的受控通道：登记「允许从 old_key 改成 new_key」的键对。
///
/// 这个表是迁移专用设施，不是业务数据：READY/TRASHED/PURGED 状态下 object_key 由
/// `enforce_media_asset_invariants` 保护为不可变，只有在此登记过的键对才能被双向改写
/// （正向＝迁移，反向＝回滚）。表在迁移与观察期结束后，随「恢复严格不可变 + 删表」的回收迁移
/// 一起移除；不要再向它写入其它用途的映射。
model MediaObjectKeyMigration {
  assetId   String    @id @map("asset_id") @db.Uuid
  oldKey    String    @map("old_key") @db.VarChar(512)
  newKey    String    @map("new_key") @db.VarChar(512)
  plannedAt DateTime  @default(now()) @map("planned_at") @db.Timestamptz(6)
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("media_object_key_migrations")
}

model ProductMedia {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  mediaAssetId     String           @map("media_asset_id") @db.Uuid
  kind             ProductMediaKind
  sortOrder        Int              @map("sort_order")
  isPrimary        Boolean          @default(false) @map("is_primary")
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  detachedByUserId String?          @map("detached_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  detachedAt       DateTime?        @map("detached_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy  User       @relation("ProductMediaCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  detachedBy User?      @relation("ProductMediaDetachedBy", fields: [detachedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("product_media")
}

model SalesOrder {
  packagingCosts PackagingCostRequest[]
  id                                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo                           String                      @unique(map: "sales_orders_order_no_key") @map("order_no") @db.VarChar(64)
  createIdempotencyKeyHash          Bytes                       @unique(map: "sales_orders_create_idempotency_key_hash_key") @map("create_idempotency_key_hash") @db.ByteA
  createRequestFingerprintHash      Bytes                       @map("create_request_fingerprint_hash") @db.ByteA
  orderDate                         DateTime                    @map("order_date") @db.Date
  issuerUserId                      String                      @map("issuer_user_id") @db.Uuid
  currencyCode                      String                      @map("currency_code") @db.VarChar(3)
  customerName                      String                      @map("customer_name") @db.VarChar(128)
  customerPhone                     String                      @map("customer_phone") @db.VarChar(64)
  customerCountryRegionId           String                      @map("customer_country_region_id") @db.Uuid
  customerProvinceStateId           String                      @map("customer_province_state_id") @db.Uuid
  customerCityId                    String                      @map("customer_city_id") @db.Uuid
  customerCountryRegionCodeSnapshot String                      @map("customer_country_region_code_snapshot") @db.VarChar(64)
  customerProvinceStateCodeSnapshot String                      @map("customer_province_state_code_snapshot") @db.VarChar(64)
  customerCityCodeSnapshot          String                      @map("customer_city_code_snapshot") @db.VarChar(64)
  customerCountryRegionNameSnapshot String                      @map("customer_country_region_name_snapshot") @db.VarChar(128)
  customerProvinceStateNameSnapshot String                      @map("customer_province_state_name_snapshot") @db.VarChar(128)
  customerCityNameSnapshot          String                      @map("customer_city_name_snapshot") @db.VarChar(128)
  customerAddressDetail             String                      @map("customer_address_detail") @db.VarChar(1000)
  customerFullAddressSnapshot       String                      @map("customer_full_address_snapshot") @db.VarChar(1500)
  lineSubtotalAmount                Decimal                     @map("line_subtotal_amount") @db.Decimal(30, 2)
  agreedTotalAmount                 Decimal                     @map("agreed_total_amount") @db.Decimal(30, 2)
  depositDueAmount                  Decimal                     @map("deposit_due_amount") @db.Decimal(30, 2)
  balanceDueAmount                  Decimal                     @map("balance_due_amount") @db.Decimal(30, 2)
  orderStatus                       SalesOrderStatus            @default(DRAFT) @map("order_status")
  fulfillmentStatus                 SalesOrderFulfillmentStatus @default(PENDING) @map("fulfillment_status")
  paymentStatus                     SalesOrderPaymentStatus     @default(UNPAID) @map("payment_status")
  remark                            String?                     @db.VarChar(1000)
  version                           Int                         @default(1)
  createdAt                         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  issuer          User                       @relation("SalesOrderIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currency        Currency                   @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  countryRegion   Region                     @relation("SalesOrderCountryRegion", fields: [customerCountryRegionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provinceState   Region                     @relation("SalesOrderProvinceState", fields: [customerProvinceStateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city            Region                     @relation("SalesOrderCity", fields: [customerCityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines           SalesOrderLine[]
  receiptRequests SalesReceiptRequest[]
  payments        SalesOrderPayment[]
  documents       SalesOrderDocument[]
  statusHistory   SalesOrderStatusHistory[]
  amountRevisions SalesOrderAmountRevision[]
  purchaseOrders  PurchaseOrder[]

  @@index([orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_order_date_id_idx")
  @@index([orderStatus, fulfillmentStatus, paymentStatus, orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_statuses_order_date_id_idx")
  @@index([currencyCode, orderStatus, customerCountryRegionId, orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_currency_country_date_idx")
  @@index([currencyCode, orderStatus, customerProvinceStateId, orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_currency_province_date_idx")
  @@index([currencyCode, orderStatus, customerCityId, orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_currency_city_date_idx")
  @@index([issuerUserId, orderDate(sort: Desc), id(sort: Desc)], map: "sales_orders_issuer_order_date_id_idx")
  reconciliationSettlements SlhReconciliationSettlement[]
  @@map("sales_orders")
}

model SalesOrderLine {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId              String             @map("sales_order_id") @db.Uuid
  lineNumber                Int                @map("line_number") @db.SmallInt
  lineType                  SalesOrderLineType @map("line_type")
  productId                 String?            @map("product_id") @db.Uuid
  productNoSnapshot         String?            @map("product_no_snapshot") @db.VarChar(64)
  productNameSnapshot       String             @map("product_name_snapshot") @db.VarChar(128)
  productAttributesSnapshot Json               @default("[]") @map("product_attributes_snapshot") @db.JsonB
  descriptionSnapshot       String?            @map("description_snapshot") @db.VarChar(1000)
  standardUnitPriceAmount   Decimal?           @map("standard_unit_price_amount") @db.Decimal(30, 2)
  actualUnitPriceAmount     Decimal            @map("actual_unit_price_amount") @db.Decimal(30, 2)
  quantity                  Int
  lineTotalAmount           Decimal            @map("line_total_amount") @db.Decimal(30, 2)
  removedAt                 DateTime?          @map("removed_at") @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([salesOrderId, lineNumber], map: "sales_order_lines_order_id_line_number_key")
  @@index([productId, salesOrderId], map: "sales_order_lines_product_id_order_id_idx")
  @@map("sales_order_lines")
}

model SalesOrderPayment {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId    String                @map("sales_order_id") @db.Uuid
  paymentType     SalesOrderPaymentType @map("payment_type")
  amount          Decimal               @db.Decimal(30, 2)
  receivedAt      DateTime              @map("received_at") @db.Timestamptz(6)
  paymentMethod   String?               @map("payment_method") @db.VarChar(64)
  remark          String?               @db.VarChar(500)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt        DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedByUserId  String?               @map("voided_by_user_id") @db.Uuid
  voidReason      String?               @map("void_reason") @db.VarChar(500)

  origin SalesOrderPaymentOrigin @default(REVIEWED)
  fundPostingBatchId String? @unique(map: "sales_order_payments_posting_batch_key") @map("fund_posting_batch_id") @db.Uuid
  fundReversalBatchId String? @unique(map: "sales_order_payments_reversal_batch_key") @map("fund_reversal_batch_id") @db.Uuid
  exchangeRateId String? @map("exchange_rate_id") @db.Uuid
  exchangeRateVersionSnapshot Int? @map("exchange_rate_version_snapshot")
  foreignUnitsPerCnySnapshot Decimal? @map("foreign_units_per_cny_snapshot") @db.Decimal(30, 4)
  exchangeRateCapturedAt DateTime? @map("exchange_rate_captured_at") @db.Timestamptz(6)
  /// 代收回填的溯源锚点：非空时唯一指向产生这笔收款的结算记录；其余来源恒为空。
