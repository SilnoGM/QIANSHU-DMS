model PurchaseOrderPart {
  containerLoadingItems ContainerLoadingItem[]

  packagingCosts PackagingCostRequest[]
  id                       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId          String @map("purchase_order_id") @db.Uuid
  key                      String @db.Uuid
  partNumber               Int    @map("part_number") @db.SmallInt
  // 提交时保存预定义分配；审核通过才生效，取消后保留唛头与分配历史。
  status                   PurchaseOrderPartStatus @default(PENDING_REVIEW)
  // 正式货件编号独立于本单内序号和唛头；历史双空只允许核对账本后一次补号。
  shipmentNo               String? @unique(map: "purchase_order_parts_shipment_no_key") @map("shipment_no") @db.VarChar(64)
  numberingIssuanceId       String? @unique(map: "purchase_order_parts_numbering_issuance_id_key") @map("numbering_issuance_id") @db.Uuid
  shippingMarkText         String? @map("shipping_mark_text") @db.VarChar(72)
  // 仅历史逐件派号保留独立 ledger；新单审核时由采购基础唛头派生，不额外消耗流水。
  shippingMarkIssuanceId   String? @unique(map: "purchase_order_parts_issuance_id_key") @map("shipping_mark_issuance_id") @db.Uuid
  shippingMarkKeyHash      Bytes?  @map("shipping_mark_key_hash") @db.ByteA
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shippingMarkIssuance NumberingIssuance? @relation("PurchasePartShippingMarkIssuance", fields: [shippingMarkIssuanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  numberingIssuance NumberingIssuance? @relation("PurchasePartNumberingIssuance", fields: [numberingIssuanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shippedAt DateTime? @map("shipped_at") @db.Timestamptz(6)
  shippedById String? @map("shipped_by_id") @db.Uuid
  shipmentRecordedAt DateTime? @map("shipment_recorded_at") @db.Timestamptz(6)
  shipmentRemark String? @map("shipment_remark") @db.VarChar(500)
  // 发货时选填的承运物流单号，随发货事实保存，重放不得覆盖。
  trackingNo String? @map("tracking_no") @db.VarChar(100)
  // 发货时必选 mainland.warehouse 稳定 value；历史未记录保留空值，发货后不可改写。
  destinationWarehouseValue String? @map("destination_warehouse_value") @db.VarChar(64)
  shippedBy User? @relation("PurchaseOrderPartShippedBy", fields: [shippedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 仓库确认收货事实；与发货事实分别冻结，不产生库存数量或资金变动。
  warehouseReceivedAt DateTime? @map("warehouse_received_at") @db.Timestamptz(6)
  warehouseReceivedById String? @map("warehouse_received_by_id") @db.Uuid
  warehouseRecordedAt DateTime? @map("warehouse_recorded_at") @db.Timestamptz(6)
  warehouseRemark String? @map("warehouse_remark") @db.VarChar(500)
  warehouseReceivedBy User? @relation("PurchaseOrderPartWarehouseReceivedBy", fields: [warehouseReceivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 装柜事实：被装柜明细行关联时一次写入，之后不可改写、不可清空；与审核状态正交，采购单取消也不清除。
  loadedAt DateTime? @map("loaded_at") @db.Timestamptz(6)
  loadedById String? @map("loaded_by_id") @db.Uuid
  loadedRecordedAt DateTime? @map("loaded_recorded_at") @db.Timestamptz(6)
  loadedBy User? @relation("PurchaseOrderPartLoadedBy", fields: [loadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // 客户签收事实：装柜后一次写入，签收后不可改写、不可清空。
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveredById String? @map("delivered_by_id") @db.Uuid
  deliveredRecordedAt DateTime? @map("delivered_recorded_at") @db.Timestamptz(6)
  deliveryRemark String? @map("delivery_remark") @db.VarChar(500)
  deliveredBy User? @relation("PurchaseOrderPartDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items PurchaseOrderPartItem[]

  @@unique([id, purchaseOrderId], map: "purchase_order_parts_id_order_id_key")
  @@unique([purchaseOrderId, key], map: "purchase_order_parts_order_id_key_key")
  @@unique([purchaseOrderId, partNumber], map: "purchase_order_parts_order_id_number_key")
  @@index([shippingMarkText], map: "purchase_order_parts_shipping_mark_text_idx")
  @@map("purchase_order_parts")
}

