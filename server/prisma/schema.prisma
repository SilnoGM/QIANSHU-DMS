generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum SessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_DISABLED
  ADMIN_RECOVERY

  @@map("session_revoked_reason")
}

enum AuthRateLimitScope {
  LOGIN_USERNAME
  LOGIN_IP
  PASSWORD_CHANGE_USER
  PASSWORD_CHANGE_IP

  @@map("auth_rate_limit_scope")
}

enum AuditActorType {
  ANONYMOUS
  USER
  SYSTEM

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

enum AuditEventType {
  AUTH_LOGIN_SUCCEEDED
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL
  USER_CREATED
  USER_UPDATED
  USER_ENABLED
  USER_DISABLED
  USER_PASSWORD_CHANGED
  USER_PASSWORD_RESET
  USER_ROLES_CHANGED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_PERMISSIONS_CHANGED
  REGION_CREATED
  REGION_UPDATED
  REGION_ENABLED
  REGION_DISABLED
  CURRENCY_CREATED
  CURRENCY_UPDATED
  CURRENCY_ENABLED
  CURRENCY_DISABLED
  EXCHANGE_RATE_CREATED
  EXCHANGE_RATE_UPDATED
  NUMBERING_RULE_CREATED
  NUMBERING_RULE_UPDATED
  NUMBERING_RULE_VERSION_PUBLISHED
  NUMBERING_RULE_ENABLED
  NUMBERING_RULE_DISABLED
  DICTIONARY_TYPE_CREATED
  DICTIONARY_TYPE_UPDATED
  DICTIONARY_TYPE_ENABLED
  DICTIONARY_TYPE_DISABLED
  DICTIONARY_ITEM_CREATED
  DICTIONARY_ITEM_UPDATED
  DICTIONARY_ITEM_ENABLED
  DICTIONARY_ITEM_DISABLED
  SYSTEM_BOOTSTRAP
  SYSTEM_ADMIN_RECOVERED
  AUTH_RETENTION_PURGED

  @@map("audit_event_type")
}

enum RegionLevel {
  COUNTRY_REGION
  PROVINCE_STATE
  CITY

  @@map("region_level")
}

enum NumberingRuleStatus {
  DRAFT
  ENABLED
  DISABLED

  @@map("numbering_rule_status")
}

enum NumberingRuleVersionStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("numbering_rule_version_status")
}

enum NumberingSegmentType {
  FIXED
  DATE
  SEPARATOR
  SEQUENCE
  RANDOM

  @@map("numbering_segment_type")
}

enum NumberingResetPolicy {
  NEVER
  YEARLY
  MONTHLY
  DAILY

  @@map("numbering_reset_policy")
}

enum NumberingDateFormat {
  YYYY
  YY
  MM
  DD
  YYYYMM
  YYYYMMDD
  YYMMDD

  @@map("numbering_date_format")
}

enum NumberingRandomMode {
  LETTERS_THEN_DIGITS
  SHUFFLED

  @@map("numbering_random_mode")
}

enum DictionaryTone {
  DEFAULT
  PRIMARY
  SUCCESS
  WARNING
  DANGER
  INFO

  @@map("dictionary_tone")
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String     @db.VarChar(128)
  usernameNormalized String     @unique(map: "users_username_normalized_key") @map("username_normalized") @db.VarChar(128)
  displayName        String     @map("display_name") @db.VarChar(128)
  passwordHash       String     @map("password_hash") @db.Text
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime   @map("password_changed_at") @db.Timestamptz(6)
  authVersion        Int        @default(0) @map("auth_version")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdByUserId    String?    @map("created_by_user_id") @db.Uuid
  disabledAt         DateTime?  @map("disabled_at") @db.Timestamptz(6)
  disabledByUserId   String?    @map("disabled_by_user_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User?         @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers  User[]        @relation("UserCreatedBy")
  disabledBy    User?         @relation("UserDisabledBy", fields: [disabledByUserId], references: [id], onDelete: Restrict)
  disabledUsers User[]        @relation("UserDisabledBy")
  roles         UserRole[]
  sessions      AuthSession[]
  auditEvents   AuditEvent[]  @relation("AuditActor")
  profile       UserProfile?

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Uuid
  email           String?  @db.VarChar(254)
  emailNormalized String?  @unique(map: "user_profiles_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  mobileE164      String?  @unique(map: "user_profiles_mobile_e164_key") @map("mobile_e164") @db.VarChar(16)
  avatarUrl       String?  @map("avatar_url") @db.VarChar(2048)
  remark          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "roles_code_key") @db.VarChar(128)
  name        String  @db.VarChar(128)
  description String? @db.Text
  isSystem    Boolean @default(false) @map("is_system")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "permissions_code_key") @db.VarChar(128)
  name        String  @db.VarChar(128)
  description String? @db.Text
  systemOnly  Boolean @default(false) @map("system_only")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId, userId], map: "user_roles_role_id_user_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId, roleId], map: "role_permissions_permission_id_role_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenHash         Bytes                 @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.ByteA
  authVersion       Int                   @map("auth_version")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime              @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     SessionRevokedReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, absoluteExpiresAt], map: "auth_sessions_user_id_revoked_at_absolute_expires_at_idx")
  @@index([idleExpiresAt], map: "auth_sessions_idle_expires_at_idx")
  @@map("auth_sessions")
}

model AuthRateLimit {
  scope           AuthRateLimitScope
  subjectKeyHash  Bytes              @map("subject_key_hash") @db.ByteA
  bucketStartedAt DateTime           @map("bucket_started_at") @db.Timestamptz(6)
  attemptCount    Int                @default(0) @map("attempt_count")
  blockedUntil    DateTime?          @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, subjectKeyHash], map: "auth_rate_limits_scope_subject_key_hash_key")
  @@index([updatedAt], map: "auth_rate_limits_updated_at_idx")
  @@index([blockedUntil], map: "auth_rate_limits_blocked_until_idx")
  @@map("auth_rate_limits")
}

model AuditEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     AuditEventType @map("event_type")
  outcome       AuditOutcome
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  targetType    String?        @map("target_type") @db.VarChar(128)
  targetId      String?        @map("target_id") @db.VarChar(128)
  requestId     String         @map("request_id") @db.VarChar(64)
  correlationId String?        @map("correlation_id") @db.VarChar(128)
  reasonCode    String?        @map("reason_code") @db.VarChar(128)
  sourceIpHash  Bytes?         @map("source_ip_hash") @db.ByteA
  metadata      Json           @default("{}") @db.JsonB

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_occurred_at_id_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_events_actor_user_id_occurred_at_idx")
  @@index([eventType, occurredAt(sort: Desc)], map: "audit_events_event_type_occurred_at_idx")
  @@map("audit_events")
}

model Region {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String      @unique(map: "regions_code_key") @db.VarChar(64)
  name               String      @db.VarChar(128)
  normalizedName     String      @map("normalized_name") @db.VarChar(128)
  englishName        String?     @map("english_name") @db.VarChar(128)
  sourceName         String?     @map("source_name") @db.VarChar(128)
  sourceCode         String?     @map("source_code") @db.VarChar(64)
  administrativeType String      @map("administrative_type") @db.VarChar(64)
  level              RegionLevel
  parentId           String?     @map("parent_id") @db.Uuid
  enabled            Boolean     @default(true)
  sortOrder          Int         @default(0) @map("sort_order")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Region[] @relation("RegionHierarchy")

  @@unique([parentId, normalizedName], map: "regions_parent_id_normalized_name_key")
  @@index([parentId, sortOrder, normalizedName, id], map: "regions_parent_id_sort_order_name_id_idx")
  @@index([level, enabled, normalizedName, id], map: "regions_level_enabled_name_id_idx")
  @@map("regions")
}

model Currency {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "currencies_code_key") @db.VarChar(3)
  name        String   @db.VarChar(128)
  englishName String?  @map("english_name") @db.VarChar(128)
  symbol      String?  @db.VarChar(16)
  minorUnit   Int      @default(2) @map("minor_unit") @db.SmallInt
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exchangeRate ExchangeRate?

  @@index([enabled, sortOrder, code, id], map: "currencies_enabled_sort_order_code_id_idx")
  @@map("currencies")
}

model ExchangeRate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyId         String   @unique(map: "exchange_rates_currency_id_key") @map("currency_id") @db.Uuid
  foreignUnitsPerCny Decimal  @map("foreign_units_per_cny") @db.Decimal(30, 12)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "exchange_rates_updated_at_id_idx")
  @@map("exchange_rates")
}

model DictionaryType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "dictionary_types_code_key") @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(500)
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items DictionaryItem[]

  @@index([sortOrder, code, id], map: "dictionary_types_sort_order_code_id_idx")
  @@index([enabled, sortOrder, code, id], map: "dictionary_types_enabled_sort_order_code_id_idx")
  @@map("dictionary_types")
}

model DictionaryItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dictionaryTypeId String         @map("dictionary_type_id") @db.Uuid
  value            String         @db.VarChar(64)
  label            String         @db.VarChar(128)
  description      String?        @db.VarChar(500)
  tone             DictionaryTone @default(DEFAULT)
  enabled          Boolean        @default(false)
  sortOrder        Int            @default(0) @map("sort_order")
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dictionaryType DictionaryType @relation(fields: [dictionaryTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dictionaryTypeId, value], map: "dictionary_items_dictionary_type_id_value_key")
  @@index([dictionaryTypeId, sortOrder, value, id], map: "dictionary_items_type_id_sort_order_value_id_idx")
  @@index([dictionaryTypeId, enabled, sortOrder, value, id], map: "dictionary_items_type_id_enabled_sort_order_value_id_idx")
  @@map("dictionary_items")
}

model NumberingRule {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleCode    String              @unique(map: "numbering_rules_rule_code_key") @map("rule_code") @db.VarChar(64)
  name        String              @db.VarChar(128)
  description String?             @db.VarChar(500)
  status      NumberingRuleStatus @default(DRAFT)
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions     NumberingRuleVersion[]
  periodStates NumberingPeriodState[]
  issuances    NumberingIssuance[]

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)], map: "numbering_rules_status_updated_at_id_idx")
  @@map("numbering_rules")
}

model NumberingRuleVersion {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId            String                     @map("rule_id") @db.Uuid
  revision          Int
  status            NumberingRuleVersionStatus @default(DRAFT)
  resetPolicy       NumberingResetPolicy       @map("reset_policy")
  timezone          String                     @default("Asia/Shanghai") @db.VarChar(64)
  configFingerprint String                     @map("config_fingerprint") @db.Char(64)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt       DateTime?                  @map("published_at") @db.Timestamptz(6)

  rule      NumberingRule          @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  segments  NumberingRuleSegment[]
  issuances NumberingIssuance[]

  @@unique([ruleId, revision], map: "numbering_rule_versions_rule_id_revision_key")
  @@unique([id, ruleId], map: "numbering_rule_versions_id_rule_id_key")
  @@index([ruleId, revision(sort: Desc), id(sort: Desc)], map: "numbering_rule_versions_rule_id_revision_id_idx")
  @@map("numbering_rule_versions")
}

model NumberingRuleSegment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId          String               @map("version_id") @db.Uuid
  position           Int
  type               NumberingSegmentType
  fixedValue         String?              @map("fixed_value") @db.VarChar(64)
  dateFormat         NumberingDateFormat? @map("date_format")
  separatorValue     String?              @map("separator_value") @db.Char(1)
  sequenceWidth      Int?                 @map("sequence_width") @db.SmallInt
  sequenceStartValue BigInt?              @map("sequence_start_value") @db.BigInt
  sequenceStep       BigInt?              @map("sequence_step") @db.BigInt
  randomLetterLength Int?                 @map("random_letter_length") @db.SmallInt
  randomDigitLength  Int?                 @map("random_digit_length") @db.SmallInt
  randomMode         NumberingRandomMode? @map("random_mode")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  version NumberingRuleVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([versionId, position], map: "numbering_rule_segments_version_id_position_key")
  @@map("numbering_rule_segments")
}

model NumberingPeriodState {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId            String   @map("rule_id") @db.Uuid
  periodKey         String   @map("period_key") @db.VarChar(16)
  nextSequenceValue BigInt?  @map("next_sequence_value") @db.BigInt
  usedCount         BigInt   @default(0) @map("used_count") @db.BigInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rule      NumberingRule       @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuances NumberingIssuance[]

  @@unique([ruleId, periodKey], map: "numbering_period_states_rule_id_period_key_key")
  @@map("numbering_period_states")
}

model NumberingIssuance {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId                 String   @map("rule_id") @db.Uuid
  ruleVersionId          String   @map("rule_version_id") @db.Uuid
  periodKey              String   @map("period_key") @db.VarChar(16)
  generatedNumber        String   @map("generated_number") @db.VarChar(64)
  sequenceValue          BigInt?  @map("sequence_value") @db.BigInt
  consumerCode           String   @map("consumer_code") @db.VarChar(64)
  idempotencyKeyHash     Bytes    @map("idempotency_key_hash") @db.ByteA
  requestFingerprintHash Bytes    @map("request_fingerprint_hash") @db.ByteA
  issuedAt               DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  rule        NumberingRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ruleVersion NumberingRuleVersion @relation(fields: [ruleVersionId, ruleId], references: [id, ruleId], onDelete: Restrict, onUpdate: Restrict)
  periodState NumberingPeriodState @relation(fields: [ruleId, periodKey], references: [ruleId, periodKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ruleId, generatedNumber], map: "numbering_issuances_rule_id_generated_number_key")
  @@unique([consumerCode, idempotencyKeyHash], map: "numbering_issuances_consumer_code_idempotency_key_hash_key")
  @@index([ruleId, periodKey, issuedAt(sort: Desc), id(sort: Desc)], map: "numbering_issuances_rule_id_period_key_issued_at_id_idx")
  @@index([ruleId, issuedAt(sort: Desc), id(sort: Desc)], map: "numbering_issuances_rule_id_issued_at_id_idx")
  @@index([ruleId, consumerCode, issuedAt(sort: Desc), id(sort: Desc)], map: "numbering_issuances_rule_id_consumer_code_issued_at_id_idx")
  @@index([ruleId, generatedNumber(ops: raw("varchar_pattern_ops"))], map: "numbering_issuances_rule_id_generated_number_prefix_idx")
  @@map("numbering_issuances")
}
