  numberingIssuanceId String @map("numbering_issuance_id") @unique(map: "slh_bills_issuance_key") @db.Uuid
  /// 归档信息由入库确认弹窗填写。名称必填，其唯一性只约束未被取代的账单，
  /// 用部分唯一索引实现（Prisma schema 表达不了 WHERE，因此只存在于迁移里）。
  billName String @map("bill_name") @db.VarChar(200)
  /// 账单所属月份（YYYY-MM）；与编号里的派发月是两回事。
  billMonth String @map("bill_month") @db.Char(7)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd DateTime @map("period_end") @db.Date
  sourceFileId String @map("source_file_id") @db.Uuid
  sourceFileName String @map("source_file_name") @db.VarChar(255)
  sourceFileSha256 String @map("source_file_sha256") @db.Char(64)
  freightTotalAmountCny Decimal @map("freight_total_amount_cny") @db.Decimal(30, 2)
  codHandlingTotalAmountCny Decimal @map("cod_handling_total_amount_cny") @db.Decimal(30, 2)
  surchargeTotalAmountCny Decimal @map("surcharge_total_amount_cny") @db.Decimal(30, 2)
  payableTotalAmountCny Decimal @map("payable_total_amount_cny") @db.Decimal(30, 2)
  codTotalAmountTwd Decimal @map("cod_total_amount_twd") @db.Decimal(30, 2)
  ntdSurchargeTotalAmountTwd Decimal @map("ntd_surcharge_total_amount_twd") @db.Decimal(30, 2)
  reportedNetAmountTwd Decimal @map("reported_net_amount_twd") @db.Decimal(30, 2)
  /// 账单自报值留痕：「合计应付人民币」行金额、台币单元格原值与公式原文。
  reportedPayableAmountCny Decimal? @map("reported_payable_amount_cny") @db.Decimal(30, 2)
  reportedNetAmountCell String? @map("reported_net_amount_cell") @db.VarChar(64)
  reportedNetAmountFormula String? @map("reported_net_amount_formula") @db.VarChar(128)
  /// 账单「小计」行自报值：用于在详情页与明细累加逐项对比。
  reportedSubtotalPayableAmountCny Decimal? @map("reported_subtotal_payable_amount_cny") @db.Decimal(30, 2)
  reportedSubtotalCodAmountTwd Decimal? @map("reported_subtotal_cod_amount_twd") @db.Decimal(30, 2)
  reportedSubtotalNtdSurchargeAmountTwd Decimal? @map("reported_subtotal_ntd_surcharge_amount_twd") @db.Decimal(30, 2)
  /// 确认入库时看到的差异与告警快照；明细行级差异也在这里，供详情页按类型分组呈现。
  importFindings Json @map("import_findings") @db.JsonB
  rateSource SlhBillRateSource? @map("rate_source")
  foreignUnitsPerCnySnapshot Decimal? @map("foreign_units_per_cny_snapshot") @db.Decimal(30, 4)
  embeddedForeignUnitsPerCny Decimal? @map("embedded_foreign_units_per_cny") @db.Decimal(30, 4)
  exchangeRateId String? @map("exchange_rate_id") @db.Uuid
  exchangeRateVersionSnapshot Int? @map("exchange_rate_version_snapshot")
  rateCapturedAt DateTime? @map("rate_captured_at") @db.Timestamptz(6)
  lineCount Int @map("line_count")
  containerBatchCount Int @map("container_batch_count")
  containerBatchNames String @map("container_batch_names") @db.VarChar(2000)
  remark String? @db.VarChar(500)
  supersededById String? @map("superseded_by_id") @db.Uuid
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  version Int @default(1)
  importRequestKeyHash Bytes @map("import_request_key_hash") @db.ByteA
  importPayloadHash Bytes @map("import_payload_hash") @db.ByteA
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz(6)

  numberingIssuance NumberingIssuance @relation(fields: [numberingIssuanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceFile MediaAsset @relation(fields: [sourceFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy SlhBill? @relation("SlhBillSupersession", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes SlhBill[] @relation("SlhBillSupersession")
  createdBy User @relation("SlhBillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User @relation("SlhBillUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines SlhBillLine[]
  reconciliationBatches SlhReconciliationBatch[]
  reconciliationSettlements SlhReconciliationSettlement[]

  @@unique([createdById, importRequestKeyHash], map: "slh_bills_actor_request_key")
  @@index([periodStart(sort: Desc), id(sort: Desc)], map: "slh_bills_period_id_idx")
  @@index([sourceFileSha256], map: "slh_bills_source_sha256_idx")
  @@map("slh_bills")
}

/// 账单明细行；原样字段与复算字段并存，差异由服务层比对呈现。
model SlhBillLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId String @map("bill_id") @db.Uuid
  lineNumber Int @map("line_number")
  loadingDate DateTime @map("loading_date") @db.Date
  containerBatchNameText String @map("container_batch_name_text") @db.VarChar(128)
  containerBatchId String? @map("container_batch_id") @db.Uuid
  warehouseReceiptReference String? @map("warehouse_receipt_reference") @db.VarChar(1000)
  shippingMarkText String? @map("shipping_mark_text") @db.VarChar(500)
  goodsName String @map("goods_name") @db.VarChar(255)
  packageCount Int @map("package_count")
  packageUnit String? @map("package_unit") @db.VarChar(32)
  grossWeightKg Decimal? @map("gross_weight_kg") @db.Decimal(18, 0)
  weightUnit String? @map("weight_unit") @db.VarChar(32)
  lengthCm Decimal? @map("length_cm") @db.Decimal(18, 0)
  widthCm Decimal? @map("width_cm") @db.Decimal(18, 0)
  heightCm Decimal? @map("height_cm") @db.Decimal(18, 0)
  volumeCai Decimal? @map("volume_cai") @db.Decimal(24, 2)
  reportedVolumeCai Decimal? @map("reported_volume_cai") @db.Decimal(24, 2)
  categoryCode String? @map("category_code") @db.VarChar(32)
  unitPriceAmount Decimal? @map("unit_price_amount") @db.Decimal(30, 2)
  pricingBasis SlhBillPricingBasis? @map("pricing_basis")
  /// 金额列为空表示「本行不涉及此项」，与 ContainerLoadingItem 同一口径；来源写 0 则保留 0。
  freightAmountCny Decimal? @map("freight_amount_cny") @db.Decimal(30, 2)
  codHandlingAmountCny Decimal? @map("cod_handling_amount_cny") @db.Decimal(30, 2)
  surchargeAmountCny Decimal? @map("surcharge_amount_cny") @db.Decimal(30, 2)
  payableAmountCny Decimal? @map("payable_amount_cny") @db.Decimal(30, 2)
  codAmountTwd Decimal? @map("cod_amount_twd") @db.Decimal(30, 2)
  ntdSurchargeAmountTwd Decimal? @map("ntd_surcharge_amount_twd") @db.Decimal(30, 2)
  recipientInfoRaw String? @map("recipient_info_raw") @db.VarChar(2000)
  /// 收货人信息解析结果（原文永久保留在 recipient_info_raw，这三列只做结构化检索与展示）。
  recipientName String? @map("recipient_name") @db.VarChar(200)
  recipientPhones String? @map("recipient_phones") @db.VarChar(500)
  recipientAddress String? @map("recipient_address") @db.VarChar(1000)
  remark String? @db.VarChar(2000)
  sourceSheetName String @map("source_sheet_name") @db.VarChar(255)
  sourceRowNumber Int @map("source_row_number")
  sourceData Json @map("source_data") @db.JsonB
  /// 明细行的对账时刻；为空即未对账。账单级三态由本列汇总派生，不另存列。
  reconciledAt DateTime? @map("reconciled_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  bill SlhBill @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  containerBatch ContainerBatch? @relation(fields: [containerBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  charges SlhBillLineCharge[]
  reconciliationSettlements SlhReconciliationSettlement[]
  reconciliationBatchLines SlhReconciliationBatchLine[]

  @@unique([billId, lineNumber], map: "slh_bill_lines_bill_line_key")
  @@index([containerBatchId], map: "slh_bill_lines_container_batch_idx")
  @@map("slh_bill_lines")
}

/// 费用明细行：从备注原文按币种拆解出的单笔杂费，合计必须等于所在行的聚合列。
model SlhBillLineCharge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId String @map("line_id") @db.Uuid
  chargeType SlhBillChargeType @map("charge_type")
  currencyCode String @map("currency_code") @db.Char(3)
  amount Decimal @db.Decimal(30, 2)
  pricingBasis SlhBillPricingBasis? @map("pricing_basis")
  sourceRemarkText String? @map("source_remark_text") @db.VarChar(2000)
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  line SlhBillLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([lineId], map: "slh_bill_line_charges_line_idx")
  @@map("slh_bill_line_charges")
}

/// 顺联航账单的对账批次：一次对账作业对应一张账单，成员行在创建时按唛头匹配结果冻结。
/// 状态不落列：completed_at 为空即进行中；批次进度只由成员行自己的核对时刻统计。
model SlhReconciliationBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchNo String @map("batch_no") @unique(map: "slh_reconciliation_batches_number_key") @db.VarChar(64)
  numberingIssuanceId String @map("numbering_issuance_id") @unique(map: "slh_reconciliation_batches_issuance_key") @db.Uuid
  billId String @map("bill_id") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById String? @map("completed_by_id") @db.Uuid
  creationRequestKeyHash Bytes @map("creation_request_key_hash") @db.ByteA
  creationPayloadHash Bytes @map("creation_payload_hash") @db.ByteA
  version Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz(6)

  bill SlhBill @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  numberingIssuance NumberingIssuance @relation(fields: [numberingIssuanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedBy User? @relation("SlhReconciliationBatchCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SlhReconciliationBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User @relation("SlhReconciliationBatchUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members SlhReconciliationBatchLine[]
  settlements SlhReconciliationSettlement[]

  @@unique([createdById, creationRequestKeyHash], map: "slh_reconciliation_batches_actor_request_key")
  @@index([billId, completedAt], map: "slh_reconciliation_batches_bill_completed_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "slh_reconciliation_batches_created_id_idx")
  @@map("slh_reconciliation_batches")
}

/// 批次成员行：创建时由匹配命中的明细行生成，matched_loading_item_id 是核对复检的锚点。
/// 核对同时写明细行的 reconciled_at（账单三态的唯一来源）与本表的 reconciled_at（批次进度）。
model SlhReconciliationBatchLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId String @map("batch_id") @db.Uuid
  lineId String @map("line_id") @db.Uuid
  matchedLoadingItemId String @map("matched_loading_item_id") @db.Uuid
  matchSource SlhBillLineMatchSource @map("match_source")
  reconciledAt DateTime? @map("reconciled_at") @db.Timestamptz(6)
  reconciledById String? @map("reconciled_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  batch SlhReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  line SlhBillLine @relation(fields: [lineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  matchedLoadingItem ContainerLoadingItem @relation(fields: [matchedLoadingItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reconciledBy User? @relation("SlhReconciliationBatchLineReconciledBy", fields: [reconciledById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([batchId, lineId], map: "slh_reconciliation_batch_lines_batch_line_key")
  @@index([lineId], map: "slh_reconciliation_batch_lines_line_idx")
  @@index([matchedLoadingItemId], map: "slh_reconciliation_batch_lines_loading_item_idx")
  @@index([batchId, reconciledAt], map: "slh_reconciliation_batch_lines_batch_reconciled_idx")
  settlements SlhReconciliationSettlement[]
  @@map("slh_reconciliation_batch_lines")
}

/// 对账结算结果的状态：有效 / 已被后续结果取代。
/// 「同一成员行最多一条 ACTIVE」由迁移里的部分唯一索引保证（Prisma schema 不表达部分索引）。
enum SlhReconciliationSettlementStatus {
  ACTIVE
  SUPERSEDED

  @@map("slh_reconciliation_settlement_status")
}

/// 对账结算结果：每次「确认结算」写入一条完整快照，同一成员行的后续结果会取代前一条。
/// 追加式留痕：DELETE 被触发器拒绝；UPDATE 只允许 status 与 updated_at，且只允许 ACTIVE → SUPERSEDED。
model SlhReconciliationSettlement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId String @map("batch_id") @db.Uuid
  batchLineId String @map("batch_line_id") @db.Uuid
  billId String @map("bill_id") @db.Uuid
  billLineId String @map("bill_line_id") @db.Uuid
  loadingItemId String @map("loading_item_id") @db.Uuid
  containerBatchId String @map("container_batch_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  salesOrderId String @map("sales_order_id") @db.Uuid
  status SlhReconciliationSettlementStatus @default(ACTIVE)
  rateSource SlhBillRateSource @map("rate_source")
  foreignUnitsPerCny Decimal @map("foreign_units_per_cny") @db.Decimal(30, 4)
  paymentFeeRate Decimal @map("payment_fee_rate") @db.Decimal(30, 3)
  salesOrderNo String @map("sales_order_no") @db.VarChar(64)
  purchaseOrderNo String @map("purchase_order_no") @db.VarChar(64)
  containerBatchNo String @map("container_batch_no") @db.VarChar(128)
  shipmentNo String? @map("shipment_no") @db.VarChar(64)
  slhBillNo String @map("slh_bill_no") @db.VarChar(64)
  warehouseReceiptReference String? @map("warehouse_receipt_reference") @db.VarChar(1000)
  shippingMarkText String? @map("shipping_mark_text") @db.VarChar(500)
  codAmountTwd Decimal? @map("cod_amount_twd") @db.Decimal(30, 2)
  codAmountCurrency String @map("cod_amount_currency") @db.Char(3)
  ntdSurchargeAmountTwd Decimal? @map("ntd_surcharge_amount_twd") @db.Decimal(30, 2)
  ntdSurchargeCurrency String @map("ntd_surcharge_currency") @db.Char(3)
  payableAmountCny Decimal? @map("payable_amount_cny") @db.Decimal(30, 2)
  payableCurrency String @map("payable_currency") @db.Char(3)
  settlementAmountCny Decimal? @map("settlement_amount_cny") @db.Decimal(30, 2)
  settlementCurrency String @map("settlement_currency") @db.Char(3)
  salesAmount Decimal? @map("sales_amount") @db.Decimal(30, 2)
  salesCurrency String @map("sales_currency") @db.Char(3)
  paymentFeeAmountCny Decimal? @map("payment_fee_amount_cny") @db.Decimal(30, 2)
  paymentFeeCurrency String @map("payment_fee_currency") @db.Char(3)
  requestKeyHash Bytes @map("request_key_hash") @db.ByteA
  payloadHash Bytes @map("payload_hash") @db.ByteA
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz(6)

  batch SlhReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batchLine SlhReconciliationBatchLine @relation(fields: [batchLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill SlhBill @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billLine SlhBillLine @relation(fields: [billLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  loadingItem ContainerLoadingItem @relation(fields: [loadingItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  containerBatch ContainerBatch @relation(fields: [containerBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("SlhReconciliationSettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 由本结算记录回填产生的销售收款（0..1）。
  payments SalesOrderPayment[] @relation("SlhReconciliationSettlementPayments")

  @@unique([createdById, requestKeyHash], map: "slh_reconciliation_settlements_actor_request_key")
  @@index([batchId, createdAt(sort: Desc)], map: "slh_reconciliation_settlements_batch_created_idx")
  @@index([batchLineId, createdAt(sort: Desc)], map: "slh_reconciliation_settlements_line_created_idx")
  @@index([billId, createdAt(sort: Desc)], map: "slh_reconciliation_settlements_bill_created_idx")
  @@index([containerBatchId], map: "slh_reconciliation_settlements_container_batch_idx")
  @@index([loadingItemId], map: "slh_reconciliation_settlements_loading_item_idx")
  @@index([salesOrderId], map: "slh_reconciliation_settlements_sales_order_idx")
  @@index([purchaseOrderId], map: "slh_reconciliation_settlements_purchase_order_idx")
  @@index([createdById, createdAt(sort: Desc)], map: "slh_reconciliation_settlements_actor_created_idx")
  @@map("slh_reconciliation_settlements")
}

/// 开票申请单状态：SETTLED 与 CANCELLED 是终态，终态后整单不可变。
/// 状态只能按迁移里的触发器白名单单向流转（退回、取消是仅有的两条逆向边）。
enum InvoiceRequestStatus {
  PENDING_REVIEW
  RETURNED
  NOTIFIED
  ISSUED
  SETTLED
  CANCELLED

  @@map("invoice_request_status")
}

/// 开票申请单的动作：每次状态流转写一条状态历史，退回与取消必须带原因。
enum InvoiceRequestAction {
  SUBMIT
  RESUBMIT
  RETURN
  NOTIFY
  UPLOAD_DOCUMENT
  SETTLE
  CANCEL

  @@map("invoice_request_action")
}

/// 开票申请单：运营提交 → 财务审核并通知 → 上传发票照片 → 结算入账。
///
/// 生命周期由迁移里的触发器封闭：不可删除；状态只能按白名单单向流转；每一步只允许写各自的列，
/// 只有 RETURNED → PENDING_REVIEW（退回重填）允许修改业务字段与明细行。
/// 申请日期即 created_at；last_submitted_at 在重新提交时刷新，created_at 不动。
/// 台币金额一律整数元（票面即整数）；settle_amount_cny 是人民币入账成本，2 位小数。
/// 发票字号（字轨号码）不记录，票面证据只有一张照片。
model InvoiceRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo String @map("invoice_no") @unique(map: "invoice_requests_number_key") @db.VarChar(64)
  numberingIssuanceId String @map("numbering_issuance_id") @unique(map: "invoice_requests_issuance_key") @db.Uuid
  status InvoiceRequestStatus @default(PENDING_REVIEW)
  buyerName String @map("buyer_name") @db.VarChar(200)
  buyerTaxId String @map("buyer_tax_id") @db.VarChar(8)
  salesAmount Decimal @map("sales_amount") @db.Decimal(30, 0)
  taxAmount Decimal @map("tax_amount") @db.Decimal(30, 0)
  totalAmount Decimal @map("total_amount") @db.Decimal(30, 0)
  invoiceRemark String? @map("invoice_remark") @db.VarChar(500)
  internalRemark String? @map("internal_remark") @db.VarChar(500)
  recipientName String @map("recipient_name") @db.Text
  recipientPhone String @map("recipient_phone") @db.Text
  recipientAddress String @map("recipient_address") @db.Text
  lastSubmittedAt DateTime @map("last_submitted_at") @db.Timestamptz(6)
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(6)
  notifiedByUserId String? @map("notified_by_user_id") @db.Uuid
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  returnedByUserId String? @map("returned_by_user_id") @db.Uuid
  documentMediaAssetId String? @map("document_media_asset_id") @unique(map: "invoice_requests_document_asset_key") @db.Uuid
  documentUploadedAt DateTime? @map("document_uploaded_at") @db.Timestamptz(6)
  documentUploadedByUserId String? @map("document_uploaded_by_user_id") @db.Uuid
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  settledByUserId String? @map("settled_by_user_id") @db.Uuid
  settleAmountCny Decimal? @map("settle_amount_cny") @db.Decimal(30, 2)
  exchangeRateId String? @map("exchange_rate_id") @db.Uuid
  exchangeRateVersionSnapshot Int? @map("exchange_rate_version_snapshot")
  foreignUnitsPerCnySnapshot Decimal? @map("foreign_units_per_cny_snapshot") @db.Decimal(30, 4)
  rateCapturedAt DateTime? @map("rate_captured_at") @db.Timestamptz(6)
  fundPostingBatchId String? @unique(map: "invoice_requests_posting_batch_key") @map("fund_posting_batch_id") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  cancelReason String? @map("cancel_reason") @db.VarChar(500)
  requestKeyHash Bytes @map("request_key_hash") @db.ByteA
  version Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz(6)

  numberingIssuance NumberingIssuance @relation(fields: [numberingIssuanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documentMediaAsset MediaAsset? @relation(fields: [documentMediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fundPostingBatch FundPostingBatch? @relation("InvoiceRequestSettlementBatch", fields: [fundPostingBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("InvoiceRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notifiedBy User? @relation("InvoiceRequestNotifiedBy", fields: [notifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  returnedBy User? @relation("InvoiceRequestReturnedBy", fields: [returnedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documentUploadedBy User? @relation("InvoiceRequestDocumentUploadedBy", fields: [documentUploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settledBy User? @relation("InvoiceRequestSettledBy", fields: [settledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy User? @relation("InvoiceRequestCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines InvoiceRequestLine[]
  statusHistory InvoiceRequestStatusHistory[]

  @@unique([createdById, requestKeyHash], map: "invoice_requests_actor_request_key")
  @@index([createdById, createdAt(sort: Desc), id(sort: Desc)], map: "invoice_requests_creator_created_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "invoice_requests_status_created_idx")
  @@index([buyerTaxId, totalAmount], map: "invoice_requests_duplicate_key_idx")
  @@map("invoice_requests")
}

/// 开票申请明细行：1–5 行，金额 = 数量 × 单价（行内勾稽由迁移里的 CHECK 保证）。
/// 可变性由父单状态决定：只有父单处于 RETURNED（退回重填）时才能改行。
model InvoiceRequestLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  lineNo Int @map("line_no")
  productName String @map("product_name") @db.VarChar(200)
  quantity Int
  unitPrice Decimal @map("unit_price") @db.Decimal(30, 0)
  amount Decimal @db.Decimal(30, 0)
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @updatedAt @db.Timestamptz(6)

  request InvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, lineNo], map: "invoice_request_lines_request_line_key")
  @@map("invoice_request_lines")
}

/// 开票申请单状态历史：追加式留痕，UPDATE / DELETE 被触发器拒绝。
/// 取消时所处的状态由 from_status 表达；SUBMIT 是首条，from_status 为空。
model InvoiceRequestStatusHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  action InvoiceRequestAction
  fromStatus InvoiceRequestStatus? @map("from_status")
  toStatus InvoiceRequestStatus @map("to_status")
  reason String? @db.VarChar(500)
  actorUserId String @map("actor_user_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @default(now()) @db.Timestamptz(6)

  request InvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation("InvoiceRequestStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId, occurredAt, id], map: "invoice_request_status_history_request_occurred_idx")
  @@map("invoice_request_status_history")
}
