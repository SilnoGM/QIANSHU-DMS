NODE_ENV=production
PORT=3000
DATABASE_URL=
APP_ORIGIN=https://dms.example.invalid
TRUST_PROXY_HOPS=1
AUTH_ARGON2_CONCURRENCY=2
AUTH_ARGON2_QUEUE_LIMIT=32
AUTH_USERNAME_HMAC_KEY=
AUTH_USER_ID_HMAC_KEY=
AUTH_IP_HMAC_KEY=
# local（默认）：assets/trash 与 staging 都在本地磁盘；cos：assets/trash 在对象存储，
# MEDIA_STORAGE_ROOT 只承担 staging 与内容校验源。切换驱动前必须先迁移存量：
#   node dist/commands/media-migration.js preview   只读预览
#   node dist/commands/media-migration.js apply     搬运 + 校验，全部通过后翻转 storage_driver
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=/var/lib/qianshu-dms/media
# 对象键的环境段：dev | test | prod。共桶时它把 assets/trash 隔成互不可见的前缀，也是 CAM 子账号
# 策略与桶生命周期规则的作用范围；不要用 NODE_ENV 代替（测试构建也可能使用 production）。
# local 驱动可省略（默认 dev）；cos 驱动必填，缺失会拒绝启动。
MEDIA_STORAGE_ENV=dev
# cos 驱动下只能使用 application：对象存储模式没有可供 Nginx 直读的本地文件。
# 保持 internal_redirect 与 cos 并存会被启动校验直接拒绝。
MEDIA_CONTENT_DELIVERY_MODE=internal_redirect
MEDIA_STAGING_TTL_HOURS=24
MEDIA_TRASH_RETENTION_DAYS=7
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_QPDF_PATH=/usr/bin/qpdf
# 仅当 MEDIA_STORAGE_DRIVER=cos 时必填。凭据必须来自只授权该桶的 CAM 子账号，
# 只写入本文件（0600，不进 Git），不得出现在日志、工单或任何文档里。
MEDIA_COS_REGION=ap-beijing
MEDIA_COS_BUCKET=
MEDIA_COS_SECRET_ID=
MEDIA_COS_SECRET_KEY=
