{
  "name": "@qianshu-dms/server",
  "version": "0.1.4",
  "private": true,
  "files": [
    "dist/",
    "prisma/schema.prisma",
    "prisma/migrations/"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "pnpm prisma:generate && nest start --watch",
    "build": "pnpm prisma:generate && nest build",
    "openapi:generate": "pnpm build && node dist/openapi/generate-openapi.js",
    "start": "pnpm prisma:generate && nest start",
    "start:prod": "node dist/main.js",
    "auth:bootstrap-admin": "node dist/cli/auth-admin/bootstrap-admin.js",
    "auth:cleanup": "node dist/commands/auth-cleanup.js",
    "auth:recover-admin": "node dist/cli/auth-admin/recover-admin.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "lint": "pnpm prisma:generate && eslint \"{src,test}/**/*.ts\" \"*.ts\"",
    "lint:fix": "pnpm prisma:generate && eslint \"{src,test}/**/*.ts\" \"*.ts\" --fix",
    "test": "pnpm prisma:generate && jest",
    "test:e2e": "pnpm prisma:generate && jest --config test/jest-e2e.json --runInBand",
    "check": "pnpm prisma:validate && pnpm typecheck && pnpm lint && pnpm test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "globals": "17.7.0",
    "jest": "29.7.0",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/generated/"
    ]
  }
}
