# 千树 DMS Server 容器环境变量模板（目标位置：/srv/qianshu-dms/server.env，权限 0600，不进 Git）。
# 与宿主部署的 server/deploy/environment/server.env.example 同源；Docker 形态下有两处差异：
#   DATABASE_URL 的主机是 compose 服务名 db；MEDIA_STORAGE_ROOT 是容器内路径（绑定挂载到宿主持久目录）。
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://<数据库用户名>:<数据库密码>@db:5432/<数据库名>
APP_ORIGIN=https://<域名>
TRUST_PROXY_HOPS=1
AUTH_ARGON2_CONCURRENCY=2
AUTH_ARGON2_QUEUE_LIMIT=32
AUTH_USERNAME_HMAC_KEY=<key1>
AUTH_USER_ID_HMAC_KEY=<key2>
AUTH_IP_HMAC_KEY=<key3>
# local（默认）：assets/trash 与 staging 都在宿主媒体目录；cos：assets/trash 在对象存储，
# 媒体目录只承担 staging 与内容校验源。切换驱动前必须先迁移存量：
#   docker compose run --rm server node dist/commands/media-migration.js preview
#   docker compose run --rm server node dist/commands/media-migration.js apply
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=/var/lib/qianshu-dms/media
# cos 驱动下只能使用 application：对象存储模式没有可供 Nginx 直读的本地文件。
MEDIA_CONTENT_DELIVERY_MODE=application
MEDIA_STAGING_TTL_HOURS=24
MEDIA_TRASH_RETENTION_DAYS=7
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_QPDF_PATH=/usr/bin/qpdf
# 仅当 MEDIA_STORAGE_DRIVER=cos 时必填。凭据必须来自只授权该桶的 CAM 子账号，
# 只写入本文件（0600，不进 Git），不得出现在日志、工单或任何文档里。
MEDIA_COS_REGION=ap-beijing
MEDIA_COS_BUCKET=
MEDIA_COS_SECRET_ID=
MEDIA_COS_SECRET_KEY=
