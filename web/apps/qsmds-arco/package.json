{
  "name": "qsmds-arco",
  "type": "module",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "api:generate": "pnpm --dir ../.. exec tsx scripts/generate-api.ts",
    "prebuild": "pnpm run api:generate",
